"""The shared build infrastructure of RowKeyDB, RowKeyRaft, Limen and
zetasketch-cpp: the image every build runs in, the platforms BuildBuddy
runs actions on, the approved versions of the shared modules, and the
shared build options."""

module(
    name = "rowkeydb_build_infra",
    version = "0.10.0",
    compatibility_level = 1,
)

# The constraints the platforms in buildbuddy/ are made of.
bazel_dep(name = "platforms", version = "1.1.0")

# The Go rules and Gazelle, declared under their own names because this
# repository's files load from them: gazelle/defs.bzl defines the Gazelle
# targets of every consumer. They are shared modules all the same.
# scripts/check.sh refuses a consumer which declares or selects another
# version of either, whatever name the consumer gives it.
bazel_dep(name = "rules_go", version = "0.64.1")
bazel_dep(name = "gazelle", version = "0.54.0")

# The Go SDK every consumer builds its Go with, Gazelle included. rules_go
# downloads a versioned SDK only when toolchain resolution selects it, and
# selects the root module's SDKs first, so this declaration costs a
# consumer nothing; scripts/check.sh requires the consumer's own SDK to be
# this version.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")

# This repository's own Go is checked with the nogo it defines for the
# consumers. rules_go reads this only when this module is the root.
go_sdk.nogo(nogo = "//go:nogo")

# The Go modules of the analyzers in go/, at the versions of golangci-lint
# 2.15.0's go.mod, which go/go.mod repeats. go_deps selects one version of
# each Go module across the whole module graph, so in a consumer these are
# lower bounds on its own Go modules.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//go:go.mod")
use_repo(
    go_deps,
    "co_honnef_go_tools",
    "com_github_gordonklaus_ineffassign",
    "com_github_kisielk_errcheck",
    "org_golang_x_tools",
)

# The approved versions of the shared modules: the large dependencies, the
# smaller ones the consumers compile with them, the rules their graphs
# hold, and rules_cc, whose C++ toolchain configuration forms every compile
# and link command. A consumer's compilation of a dependency is shared with
# another's only when every one of these is at the same version in both.
# Each is a "nodep" dependency (repo_name = None): it takes effect only in a
# graph which already contains the module by another path, where it is a
# lower bound, and adds the module nowhere else. scripts/check.sh takes
# every nodep dependency here as a shared module, and refuses a consumer
# which declares or selects another version of one, or names one other
# than by its own repository name.
bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name = None)
bazel_dep(name = "protobuf", version = "36.2", repo_name = None)
bazel_dep(name = "grpc", version = "1.85.0", repo_name = None)
bazel_dep(name = "opentelemetry-cpp", version = "1.30.0", repo_name = None)
bazel_dep(name = "googletest", version = "1.18.0", repo_name = None)
bazel_dep(name = "zlib", version = "1.3.2.bcr.2", repo_name = None)
bazel_dep(name = "re2", version = "2025-11-05.bcr.1", repo_name = None)
bazel_dep(name = "rules_cc", version = "0.2.26", repo_name = None)
bazel_dep(name = "boringssl", version = "0.20260616.0", repo_name = None)
bazel_dep(name = "c-ares", version = "1.34.5.bcr.2", repo_name = None)
bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name = None)
bazel_dep(name = "protoc-gen-validate", version = "1.2.1.bcr.2", repo_name = None)
bazel_dep(name = "bazel_lib", version = "3.2.2", repo_name = None)
bazel_dep(name = "bazel_skylib", version = "1.9.2", repo_name = None)
bazel_dep(name = "package_metadata", version = "0.0.7", repo_name = None)
bazel_dep(name = "rules_proto", version = "7.1.0", repo_name = None)
bazel_dep(name = "rules_python", version = "2.2.0", repo_name = None)

# googleapis and its two C++ modules, at the version gRPC brings into the
# graph. Its Bigtable protos are rowkeydb's API, so a new version is
# approved only once rowkeydb's conformance suite passes on it.
bazel_dep(name = "googleapis", version = "0.0.0-20260825-d10ac924", repo_name = None)
bazel_dep(name = "googleapis-cc", version = "1.0.0", repo_name = None)
bazel_dep(name = "googleapis-grpc-cc", version = "1.0.0", repo_name = None)
