"""The shared build infrastructure of RowKeyDB, RowKeyRaft, Limen and
zetasketch-cpp: the image every build runs in, the approved versions of the
shared modules, and the shared build options."""

module(
    name = "rowkeydb_build_infra",
    version = "0.3.2",
    compatibility_level = 1,
)

# The approved versions of the four shared modules. Each is a "nodep"
# dependency (repo_name = None): it takes effect only in a graph which
# already contains the module by another path, where it is a lower bound,
# and adds the module nowhere else. Every consumer declares the same
# versions; scripts/check.sh compares them.
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = None)
bazel_dep(name = "protobuf", version = "33.5", repo_name = None)
bazel_dep(name = "grpc", version = "1.81.1", repo_name = None)
bazel_dep(name = "opentelemetry-cpp", version = "1.24.0.bcr.1", repo_name = None)
