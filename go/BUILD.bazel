load("@rules_go//go:def.bzl", "nogo")
load(":analyzers.bzl", "GOVET", "OTHERS", "STATICCHECK")

# gazelle:prefix github.com/rowkeydb-com/rowkeydb-build-infra/go
# gazelle:exclude tools.go

# The static analysis of every consumer's Go, which replaces go vet and
# golangci-lint: a consumer with Go registers it in its MODULE.bazel with
# go_sdk.nogo(nogo = "@rowkeydb_build_infra//go:nogo"). A finding of any
# analyzer fails the build of the package it is in. With Bzlmod, nogo
# checks only the root module's packages, as golangci-lint checks only the
# module it runs in.
nogo(
    name = "nogo",
    visibility = ["//visibility:public"],
    deps = GOVET + STATICCHECK + OTHERS,
)
